{
  "name": "agropilot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=api --filter=web",
    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=web",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "seed": "pnpm --filter @workspace/seeds seed",
    "jobs:oil": "pnpm --filter @workspace/jobs job:oil-prices",
    "jobs:weather": "pnpm --filter @workspace/jobs job:weather-stations",
    "jobs:recommendations": "pnpm --filter @workspace/jobs job:parcel-recommendations"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  }
}
