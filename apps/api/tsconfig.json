{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@env": ["env.d.ts"],
      "@workspace/db": ["../../packages/db/src/index.ts"],
      "@workspace/auth": ["../../packages/auth/src/index.ts"],
      "@workspace/schemas": ["../../packages/schemas/src/index.ts"]
    }
  }
}
