{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/web/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@env": ["../api/env.d.ts"],
      "@workspace/api": ["../api/src/index.ts"],
      "@workspace/api/*": ["../api/src/*"],
      "@workspace/auth": ["../../packages/auth/src/index.ts"],
      "@workspace/auth/*": ["../../packages/auth/src/*"],
      "@workspace/schemas": ["../../packages/schemas/src/index.ts"],
      "@workspace/schemas/*": ["../../packages/schemas/src/*"],
      "@workspace/copilot": ["../../packages/copilot/src/index.ts"],
      "@workspace/copilot/*": ["../../packages/copilot/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
