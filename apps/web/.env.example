NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_API_VERSION="v1"
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000/dashboard"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001/api/v1/auth"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ORIGINS="http://localhost:3000"
DATABASE_URL="postgresql://user:password@localhost:5432/db"

DEMO_USER_PASSWORD=""
DEMO_ENABLED="true"

# Modo demo (sin API ni DB). Actívalo en Vercel para desplegar
# solo el frontend con datos simulados.
# Cuando está activo:
#   - Se salta la autenticación
#   - Las llamadas a la API devuelven mocks desde lib/mockdata.ts
#   - El botón "Ver demo" entra directamente a /dashboard
# En local puede dejarse en "true" para trabajar sin backend.
NEXT_PUBLIC_DEMO_MODE="false"
