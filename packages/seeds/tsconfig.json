{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/api/*": ["../../apps/api/src/*"],
      "@workspace/api/env": ["../../apps/api/env.d.ts"],
      "@workspace/scrapers": ["../../packages/scrapers/src/index.ts"]
    }
  },
  "include": ["src"]
}
